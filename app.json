{
  "expo": {
    "name": "JobSnap",
    "slug": "jobsnap",
    "scheme": "jobsnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobsnap.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "JobSnap records where on-site work happens so your manager can verify the job location."
      }
    },
    "android": {
      "package": "com.jobsnap.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0F11"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "JobSnap needs photo access so you can attach photos of completed work.",
          "cameraPermission": "JobSnap needs camera access so you can snap photos and video on the job."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JobSnap records where on-site work happens so your manager can verify the job location."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F11"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "350e04f5-54b9-4054-949f-bdd82a7b4d6b"
      }
    }
  }
}
